{
  "name": "@ryo9ra/su-css",
  "version": "0.0.2",
  "description": "素のHTMLだけで整ったUIを実現する、クラスレス・依存ゼロのアクセシブルなCSSフレームワーク / A zero-class, zero-dependency, accessible CSS framework for plain semantic HTML.",
  "keywords": [
    "css",
    "classless",
    "classless-css",
    "css-framework",
    "semantic-html",
    "dark-mode",
    "accessibility",
    "a11y",
    "wcag"
  ],
  "homepage": "https://ryotasugawara.github.io/su-css/",
  "bugs": {
    "url": "https://github.com/RyotaSugawara/su-css/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyotaSugawara/su-css.git"
  },
  "license": "MIT",
  "author": "Ryota Sugawara",
  "type": "module",
  "main": "./dist-lib/sucss.css",
  "style": "./dist-lib/sucss.css",
  "exports": {
    ".": "./dist-lib/sucss.css",
    "./sucss.css": "./dist-lib/sucss.css",
    "./sucss.min.css": "./dist-lib/sucss.min.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist-lib/sucss.css",
    "dist-lib/sucss.min.css",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:lib": "node scripts/build-lib.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-lib",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "check:unpublished": "node scripts/check-unpublished.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build:lib",
    "release:dry-run": "npm publish --dry-run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.34.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
