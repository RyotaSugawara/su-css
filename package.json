{
  "name": "@ryo9ra/su-css",
  "version": "0.7.0",
  "description": "素のHTMLだけで整ったUIを実現する、クラスレス・依存ゼロのアクセシブルなCSSフレームワーク / A zero-class, zero-dependency, accessible CSS framework for plain semantic HTML.",
  "keywords": [
    "css",
    "classless",
    "classless-css",
    "css-framework",
    "semantic-html",
    "dark-mode",
    "accessibility",
    "a11y",
    "wcag"
  ],
  "homepage": "https://ryotasugawara.github.io/su-css/",
  "bugs": {
    "url": "https://github.com/RyotaSugawara/su-css/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyotaSugawara/su-css.git"
  },
  "license": "MIT",
  "author": "Ryota Sugawara",
  "type": "module",
  "main": "./dist-lib/sucss.css",
  "style": "./dist-lib/sucss.css",
  "exports": {
    ".": "./dist-lib/sucss.css",
    "./sucss.css": "./dist-lib/sucss.css",
    "./sucss.min.css": "./dist-lib/sucss.min.css",
    "./behaviors.js": "./dist-lib/behaviors.js",
    "./behaviors.min.js": "./dist-lib/behaviors.min.js",
    "./behaviors/enhance.js": "./dist-lib/behaviors/enhance.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist-lib/behaviors.js",
    "./dist-lib/behaviors.min.js",
    "./src/behaviors.js"
  ],
  "files": [
    "dist-lib/sucss.css",
    "dist-lib/sucss.min.css",
    "dist-lib/behaviors.js",
    "dist-lib/behaviors.min.js",
    "dist-lib/behaviors/enhance.js",
    "dist-lib/behaviors/toolbar.js",
    "dist-lib/behaviors/tablist.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "predev": "npm run build:pages",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run build:pages",
    "build": "vite build",
    "build:lib": "node scripts/build-lib.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "build:review": "node scripts/build-review.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-lib",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "check:unpublished": "node scripts/check-unpublished.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:behaviors": "playwright test",
    "prepack": "npm run build:lib",
    "release:dry-run": "npm publish --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.26",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
